        "def pas_armijo(img, v, E,grad_E, d,  Lambda, cst=0.5, beta=0.5):\n",
        "    pas = 10\n",
        "    #on fait les calcul necessaire dans la condition pour les faire qu'une fois\n",
        "    Energie = E(img, v, Lambda)\n",
        "    gradienE = grad_E(img, v, Lambda)\n",
        "    n, m = img.shape[:2]\n",
        "    gradien_new = gradienE.reshape(n * m, 3) #on transforme la matrice pour pouvoir calculer la norme\n",
        "    norme = np.linalg.norm( gradien_new, 'fro') ** 2\n",
        "    it = 0\n",
        "    while ((Energie - E(img + pas * d, v, Lambda)) <= pas * cst * norme) and (it < 10):\n",
        "        pas *= beta\n",
        "        #print(pas)\n",
        "        it += 1\n",
        "    return pas\n",
        "\n",
        "\n",
        "def demosaicage(v, img_reference, Lambda, nbIter,  beta=0.5, c=0.5):\n",
        "    out = np.zeros((v.shape[0], v.shape[1], 3))\n",
        "    Energie = []\n",
        "    for it in range(nbIter):\n",
        "        d = -grad_E(out, v, Lambda) # Direction de descente moins le gradient\n",
        "        step = pas_armijo(out, v,E, grad_E, d,Lambda, c, beta ) # Calcul du pas selon Armijo\n",
        "        out = out + step * d # Mise à jour nouvel itéré (+ car d c'est la direction donc -gradient)\n",
        "\n",
        "        # Calcul de la différence par rapport à l'image de référence\n",
        "        diff = np.linalg.norm(out - img_reference)\n",
        "        Energie.append( E(out, v, Lambda))\n",
        "        #if it % 2== 0 :\n",
        "            #print('iter =', it, 'fonction =', E(out, v, Lambda), 'distance a la solution =', diff)\n",
        "\n",
        "\n",
        "    return out,Energie\n",
        "\n",
        "\n"
      ],
