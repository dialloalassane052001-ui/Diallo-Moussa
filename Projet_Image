      "metadata": {
        "id": "dt5gu_wF5-8k"
      },
      "outputs": [],
      "source": [
        "#implementation F\n",
        "def F(img):\n",
        "    n,m = (img.shape[0],img.shape[1])\n",
        "    v = np.zeros((n, m))\n",
        "\n",
        "    #Parcours lignes et colonnes de l'image\n",
        "    for l in range(n):\n",
        "        for c in range(m):\n",
        "            #extraction des couleurs\n",
        "            if l%2==0 and c%2==0:\n",
        "                v[l,c] = img[l,c,2]\n",
        "            elif l%2==1 and c%2==1:\n",
        "                v[l,c] = img[l,c,0]\n",
        "            else:\n",
        "                v[l,c] = img[l,c,1]\n",
        "    return v\n",
        "\n",
        "\n",
        "#implementation de l'adjoint\n",
        "\n",
        "def F_adjoint(image):\n",
        "    n,m = np.shape(image)\n",
        "    v = np.zeros((n,m, 3))\n",
        "    # Parcours des lignes et des colonnes de l'image\n",
        "    for l in range(n):\n",
        "        for c in range(m):\n",
        "            if l % 2 == 0 and c % 2 == 0:\n",
        "                v[l, c, 2] = image[l, c]\n",
        "            elif l % 2 == 1 and c % 2 == 1:\n",
        "                v[l, c, 0] = image[l, c]\n",
        "            else:\n",
        "                v[l, c, 1] = image[l, c]\n",
        "\n",
        "    return v"
      ],
