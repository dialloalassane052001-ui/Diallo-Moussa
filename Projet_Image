        "# Calcul du gradient en x\n",
        "def grad_x(img, adjoint):\n",
        "    n,p,q = np.shape(img)\n",
        "\n",
        "    if adjoint ==0:\n",
        "        #on crée une matrice avec les colonnes décalées\n",
        "        decal = np.concatenate((np.zeros((1,p,q), dtype= int), img), axis=0) #on ajoute une ligne en haut de img\n",
        "        decal[0]= img[-1]\n",
        "        decal = decal[:-1]\n",
        "        return decal-img\n",
        "\n",
        "    else:\n",
        "        #on crée une matrice avec les colonnes décalées\n",
        "        decal = np.concatenate((img,np.zeros((1,p,q), dtype= int)), axis=0) #on ajoute une ligne en bas de img\n",
        "        decal[-1]=img[0]\n",
        "        decal = decal[1:]\n",
        "        return decal -img\n",
        "\n",
        "\n",
        "# Calcul du gradient en y\n",
        "def grad_y(img, adjoint):\n",
        "    n,p,q = np.shape(img)\n",
        "    colonne = np.zeros((n,1,3), dtype= int) #crée une colonne de 0\n",
        "\n",
        "    if adjoint ==0:\n",
        "        #on crée une matrice avec les colonnes décalées\n",
        "        decal = np.hstack((colonne, img)) #ajout colonne à gauche\n",
        "        decal[:, 0, :]= img[:,-1,:]\n",
        "        decal = decal[:, :-1, :]\n",
        "        return decal-img\n",
        "\n",
        "    else:\n",
        "        #on crée une matrice avec les colonnes décalées\n",
        "        decal =np.hstack((img,colonne)) #on ajoute une ligne en bas de img\n",
        "        decal[:,-1,:]=img[:, 0, :]\n",
        "        decal = decal[:, 1:, :]\n",
        "        return decal -img\n",
        "\n",
        "\n",
        "# Fonction phi\n",
        "def phi(x,eps):\n",
        "    return np.sqrt(x+eps)\n",
        "\n",
        "# Fonction dérivée de phi\n",
        "def phi_prim(img,eps):\n",
        "    return np.sqrt(1/(4*(img+eps)))\n",
        "\n",
        "# Calcul de la variation totale\n",
        "def TVe(out,eps):\n",
        "    tmpx = grad_x(out,0)\n",
        "    tmpy = grad_y(out,0)\n",
        "    tmp = phi(np.sum(tmpx**2)+np.sum(tmpy**2),eps)\n",
        "\n",
        "    return np.sum(tmp)\n",
        "\n",
        "#Calcul du gradient de la variation totale\n",
        "def grad_TVe(out, eps = 0.01):\n",
        "    tmpx = grad_x(out,0)\n",
        "    tmpy = grad_y(out,0)\n",
        "    X = 2 * phi_prim(tmpx**2 + tmpy**2,eps) * tmpx\n",
        "    Y = 2 * phi_prim(tmpx**2 + tmpy**2,eps) * tmpy\n",
        "\n",
        "    return grad_x(X,1) + grad_y(Y,1)\n",
        "\n",
        "\n",
        "\n",
        "# Calcul de l'énergie\n",
        "def E(out,v,Lambda,eps=0.01):\n",
        "    return TVe(out,eps) + Lambda*np.linalg.norm(F(out)-v)**2\n",
        "\n",
        "\n",
        "# Calcul du gradient de l'énergie\n",
        "def grad_E(out,v,Lambda,eps=0.01):\n",
        "    return grad_TVe(out,eps) + 2*Lambda*F_adjoint(F(out)-v)\n",
        "\n"
      ],
